---
import type { TeamMember } from "../data/teamData";
import { siteData } from "../data/siteData";
import Icon from "./ui/Icon.astro";

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<div
  class="bg-neutral-surface rounded-2xl border border-slate-200/80 border-t-4 border-t-primary shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col justify-between group h-full"
>
  <div>
    <div
      class="relative w-full h-70 bg-slate-100 overflow-hidden shrink-0"
    >
      <img
        src={member.image}
        alt={`Foto de ${member.name}`}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-transparent"
      >
      </div>

      {
        member.badge && (
          <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-neutral-surface/90 backdrop-blur-md text-secondary border border-slate-200 shadow-2xs z-10">
            {member.badge}
          </span>
        )
      }

      {
        member.license && (
          <span class="absolute bottom-3 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-white/90 text-neutral-title backdrop-blur-xs border border-white/20 z-10">
            {member.license}
          </span>
        )
      }
    </div>

    <div class="p-5 space-y-3">
      <div>
        <span
          class="text-[10px] font-bold uppercase tracking-wider text-primary block leading-none"
        >
          {member.role}
        </span>
        <h2 class="text-lg font-bold text-neutral-title mt-1 leading-tight group-hover:text-primary transition-colors">
          {member.name}
        </h2>
      </div>

      {
        member.topics && member.topics.length > 0 && (
          <div class="border-t border-slate-100 pt-2.5">
            <h3 class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
              Áreas Principales
            </h3>
            <ul class="space-y-1 text-xs text-neutral-text">
              {member.topics.map((topic) => (
                <li class="flex items-start gap-1.5">
                  <Icon
                    name="check"
                    class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5"
                  />
                  <span class="text-[11px] sm:text-xs leading-tight">
                    {topic}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  <div class="p-5 pt-0 space-y-2.5 mt-auto">
    {
      member.schedule && (
        <div class="flex items-center gap-2 text-xs text-slate-600 bg-slate-50 p-2 rounded-xl border border-slate-100">
          <Icon name="clock" class="w-3.5 h-3.5 text-accent shrink-0" />
          <div class="min-w-0">
            <span class="font-semibold text-neutral-title block text-[10px] leading-none mb-0.5">
              Horarios
            </span>
            <span class="text-[11px] block truncate leading-tight">
              {member.schedule}
            </span>
          </div>
        </div>
      )
    }

    <a
      href={member.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-2 px-3 rounded-xl text-white text-xs font-bold bg-primary hover:bg-primary-hover transition-all duration-200 flex items-center justify-center gap-1.5 group/btn"
      aria-label={`Solicitar turno con ${member.name}`}
    >
      <span>Solicitar turno</span>
      <Icon
        name="arrow-right"
        class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5"
      />
    </a>
  </div>
</div>