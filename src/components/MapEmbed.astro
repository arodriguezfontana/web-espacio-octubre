---
import { siteData } from '../data/siteData';
import Icon from './ui/Icon.astro';

---

<div class="bg-neutral-surface rounded-3xl border border-slate-200/80 overflow-hidden shadow-xs flex flex-col h-full min-h-[420px]">
  <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h3 class="text-lg font-bold text-neutral-title">
        Ubicación
      </h3>
      <p class="text-xs text-neutral-text mt-0.5">
        {siteData.location.address}, {siteData.location.city}
      </p>
    </div>

    <a 
      href={siteData.location.googleMapsExternalUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-secondary transition-colors group"
      aria-label="Abrir ubicación en Google Maps"
    >
      <span>Google Maps</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>

  <div class="grow relative w-full h-full min-h-[340px] bg-slate-100">
    <iframe 
      title={`Ubicación de ${siteData.name}`}
      src={siteData.location.embedMapUrl} 
      class="absolute inset-0 w-full h-full border-0" 
      allowfullscreen="" 
      loading="lazy" 
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</div>