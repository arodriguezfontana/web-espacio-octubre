---
import type { FaqItem } from '../data/faqData';
import Icon from './ui/Icon.astro';

interface Props {
  faq: FaqItem;
}

const { faq } = Astro.props;
---

<details class="bg-neutral-surface rounded-2xl border border-slate-200/80 border-l-[6px] border-l-secondary shadow-2xs hover:shadow-xs transition-all duration-300 group overflow-hidden">
  
  <summary class="p-4 sm:p-5 cursor-pointer flex items-center justify-between gap-4 select-none list-none [&::-webkit-details-marker]:hidden bg-neutral-surface group-open:bg-slate-50/50 transition-colors">
    <span class="text-sm sm:text-base text-neutral-title group-hover:text-primary transition-colors duration-200">
      {faq.question}
    </span>
    
    <div class="w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 text-slate-400 group-hover:text-primary group-open:rotate-180 group-open:bg-primary/10 group-open:text-primary transition-all duration-300">
      <Icon name="arrow-right" class="w-3.5 h-3.5 rotate-90" />
    </div>
  </summary>

  <div class="px-4 sm:px-5 pb-5 pt-1 text-neutral-text text-xs sm:text-sm leading-relaxed border-t border-slate-100/60 bg-slate-50/30 font-normal">
    {faq.answer}
  </div>

</details>