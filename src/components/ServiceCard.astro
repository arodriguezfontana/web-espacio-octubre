---
import type { ServiceItem } from '../data/servicesData';
import { siteData } from '../data/siteData';
import Icon from './ui/Icon.astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const customWhatsappUrl = `https://wa.me/${siteData.contact.phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hola! Quisiera realizar una consulta sobre el área de ${service.title}.`)}`;
---

<div 
  id={service.id}
  class="bg-neutral-surface p-6 sm:p-7 rounded-3xl border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-6 group"
>
  <div class="space-y-2 md:max-w-md">
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-primary shrink-0 mt-0.5"></span>
      <h3 class="text-xl font-bold text-neutral-title group-hover:text-primary transition-colors">
        {service.title}
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-neutral-text leading-relaxed">
      {service.description}
    </p>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 border-t md:border-t-0 md:border-l border-slate-100 pt-4 md:pt-0 md:pl-6">

    <a 
      href={customWhatsappUrl} 
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-primary hover:bg-primary-hover transition-colors shrink-0 flex items-center justify-center gap-2 shadow-xs group/btn"
      aria-label={`Consultar por WhatsApp sobre el área de ${service.title}`}
    >
      <span>Consultar</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5" />
    </a>
  </div>
</div>