---
import ButtonCTA from './ui/ButtonCTA.astro';
import { siteData } from '../data/siteData';
---

<section class="relative w-full h-[75vh] min-h-[500px] max-h-[750px] bg-slate-950 overflow-hidden">
  <img 
    src="/assets/consultorio-2.png" 
    alt={`Instalaciones de ${siteData.name}`} 
    class="w-full h-full object-cover object-center opacity-70"
    loading="eager"
    fetchpriority="high"
  />

  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/20 flex items-end pb-12 sm:pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl space-y-4 sm:space-y-5">
      
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium text-white/95 bg-white/10 backdrop-blur-md border border-white/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse shrink-0"></span>
          <span>Atención Presencial y Virtual</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
          {siteData.name}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          {siteData.description}
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <ButtonCTA href={siteData.contact.whatsappUrl}>
            Solicitar Turno
          </ButtonCTA>
          <a 
            href="/servicios" 
            class="px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all duration-200 text-center focus:outline-none focus:ring-2 focus:ring-white/50"
          >
            Conocer Servicios
          </a>
        </div>

      </div>
    </div>
  </div>
</section>