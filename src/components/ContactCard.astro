---
import Icon from './ui/Icon.astro';

interface Props {
  title: string;
  value: string;
  href?: string;
  icon: 'whatsapp' | 'location' | 'email' | 'clock' | 'instagram';
  borderColor?: string;
}

const { 
  title, 
  value, 
  href, 
  icon,
  borderColor = 'border-t-primary'
} = Astro.props;

const isLink = Boolean(href);
const Tag = isLink ? 'a' : 'div';
---

<Tag 
  href={href}
  target={isLink && href?.startsWith('http') ? '_blank' : undefined}
  rel={isLink && href?.startsWith('http') ? 'noopener noreferrer' : undefined}
  class={`bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-t-4 ${borderColor} shadow-xs ${isLink ? 'hover:shadow-md transition-all duration-300 group hover:-translate-y-0.5' : ''} flex flex-col justify-between`}
>
  <div>
    <div class="w-10 h-10 rounded-xl bg-primary-extra-light text-primary flex items-center justify-center mb-4 border border-primary/10">
      <Icon name={icon} class="w-5 h-5" />
    </div>
    
    <h3 class="text-base font-bold text-neutral-title mb-1">
      {title}
    </h3>
  </div>

  <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
    <span class={`text-xs ${isLink ? 'text-primary group-hover:underline' : 'text-slate-700'} truncate`}>
      {value}
    </span>
    
    {isLink && (
      <Icon name="arrow-right" class="w-3.5 h-3.5 text-primary shrink-0 transition-transform group-hover:translate-x-1" />
    )}
  </div>
</Tag>