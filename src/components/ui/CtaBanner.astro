---
import ButtonCTA from './ButtonCTA.astro';
import { siteData } from '../../data/siteData';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  variant?: 'light' | 'dark';
}

const { 
  title = "¿Tenés dudas o querés coordinar una consulta?",
  description = "Escribinos directamente por WhatsApp y te orientamos en el momento.",
  buttonText = "Realizar Consulta",
  variant = 'light'
} = Astro.props;

const isDark = variant === 'dark';
---

<section 
  class={isDark 
    ? "w-full bg-primary-dark/80 border-y border-white/10 py-7 sm:py-9 text-slate-200" 
    : "w-full bg-neutral-surface border-y border-slate-200/80 py-7 sm:py-9 text-neutral-text"
  }
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-xl mx-auto space-y-2.5">
      <h2 class={`text-lg sm:text-xl md:text-2xl font-bold tracking-tight ${isDark ? "text-white" : "text-neutral-title"}`}>
        {title}
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed text-slate-600">
        {description}
      </p>
      <div class="pt-1.5 flex justify-center">
        <ButtonCTA href={siteData.contact.whatsappUrl}>
          {buttonText}
        </ButtonCTA>
      </div>
    </div>
  </div>
</section>