---
import { siteData } from "../data/siteData";
import Icon from "./ui/Icon.astro";
---

<div class="bg-secondary text-white text-[11px] sm:text-xs font-sans tracking-tight py-2 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2.5">
    
    <div class="flex items-center gap-4 text-white/90">
      <a
        href={siteData.location.googleMapsExternalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-white/95 hover:text-white hover:underline transition-all duration-150 focus:outline-none focus:underline font-medium"
      >
        <Icon
          name="location"
          class="w-3.5 h-3.5 text-primary-light shrink-0"
        />
        <span>{siteData.location.address}, {siteData.location.city}</span>
      </a>

      <span class="hidden md:inline text-white/30 font-light">|</span>

      <div class="hidden md:inline-flex items-center gap-1.5 text-white/80 font-normal">
        <Icon name="clock" class="w-3.5 h-3.5 text-primary-light shrink-0" />
        <span>{siteData.contact.hours} / {siteData.contact.hourswe}</span>
      </div>
    </div>

    <div class="flex items-center gap-4 sm:gap-5">
      <a
        href={siteData.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-white/95 hover:text-white hover:underline transition-all duration-150 focus:outline-none focus:underline font-medium"
        aria-label={`Contactar por WhatsApp al ${siteData.contact.phoneDisplay}`}
      >
        <Icon name="whatsapp" class="w-3.5 h-3.5 text-primary-light shrink-0" />
        <span>{siteData.contact.phoneDisplay}</span>
      </a>

      <span class="hidden md:inline text-white/30 font-light">|</span>

      <a
        href={siteData.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-white/95 hover:text-white hover:underline transition-all duration-150 focus:outline-none focus:underline font-medium"
        aria-label={`Visitar Instagram de ${siteData.name}`}
      >
        <Icon name="instagram" class="w-3.5 h-3.5 text-primary-light shrink-0" />
        <span>@espaciooctubre</span>
      </a>
    </div>

  </div>
</div>