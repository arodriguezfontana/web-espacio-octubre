---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ContactCard from '../components/ContactCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { siteData } from '../data/siteData';
---

<Layout 
    title="Espacio Octubre | Contacto"
  description="Canales de atención en Espacio Octubre. Escribinos por WhatsApp, Instagram, correo electrónico o visítanos en Bernal."
>

  <PageHeader 
    badge="Contacto"
    title="Canales de Atención"
  />

  <section class="py-10 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        
        <ContactCard 
          title="WhatsApp"
          value={siteData.contact.phoneDisplay}
          href={siteData.contact.whatsappUrl}
          icon="whatsapp"
          borderColor="border-t-primary"
        />

        <ContactCard 
          title="Ubicación"
          value={`${siteData.location.address}, ${siteData.location.city}`}
          href={siteData.location.googleMapsExternalUrl}
          icon="location"
          borderColor="border-t-primary"
        />

        <ContactCard 
          title="Horarios de Atención"
          value={siteData.contact.hours}
          icon="clock"
          borderColor="border-t-primary"
        />

        <ContactCard 
          title="Instagram"
          value="@espaciooctubre"
          href={siteData.social.instagram}
          icon="instagram"
          borderColor="border-t-primary"
        />

      </div>

      <MapEmbed />

    </div>
  </section>

</Layout>