---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import FaqItemCard from '../components/FaqItemCard.astro';
import Icon from '../components/ui/Icon.astro';
import { faqData } from '../data/faqData';
import { siteData } from '../data/siteData';
---

<Layout 
  title="Espacio Octubre | Preguntas Frecuentes"
  description="Resolvemos tus dudas sobre solicitud de turnos, modalidades presencial y virtual, obras sociales, reintegros y primera consulta en Espacio Octubre."
>
  <PageHeader 
    badge="Preguntas Frecuentes"
    title="Resolvemos tus dudas"
  />

  <section class="py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
<div class="lg:col-span-4">
  <div class="bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-l-[6px] border-l-accent shadow-2xs space-y-5">
    
    <div>
      <h2 class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">
        Modalidades
      </h2>
      <div class="space-y-2 text-sm text-neutral-title ">
        <div class="flex items-center gap-2">
          <Icon name="location" class="w-4 h-4 text-accent" />
          <span>Atención Presencial</span>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="whatsapp" class="w-3 h-3 text-accent" />
          <span class="ml-1">Sesiones Virtuales</span>
        </div>
      </div>
    </div>

    <div class="pt-4 border-t border-slate-100">
      <h2 class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">
        Horarios de atención
      </h2>
      <div class="flex items-start gap-2 text-xs text-neutral-text leading-tight mt-1.5">
        <Icon name="clock" class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" />
        <div>
          <span class="block">{siteData.contact.hours}</span>
        </div>
      </div>
    </div>

  </div>
</div>

        <div class="lg:col-span-8 space-y-3">
          {faqData.map((faq) => (
            <FaqItemCard faq={faq} />
          ))}
        </div>

      </div>
    </div>
  </section>

</Layout>