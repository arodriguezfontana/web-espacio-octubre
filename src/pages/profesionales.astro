---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TeamCard from '../components/TeamCard.astro';
import { teamData } from '../data/teamData';
---

<Layout 
  title="Espacio Octubre | Equipo"
  description="Conocé a las profesionales de Espacio Octubre: especialidades, trayectoria y horarios de atención en Psicología."
>

  <PageHeader 
    badge="Equipo"
    title="Conocé a nuestras profesionales"
  />

  <section class="py-10 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {teamData.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>
    </div>
  </section>

</Layout>